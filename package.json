{
  "name": "troupe",
  "private": true,
  "scripts": {
    "dev": "concurrently \"pnpm --filter server dev\" \"wait-on tcp:127.0.0.1:3001 && pnpm --filter client dev\"",
    "build": "pnpm --filter client build && pnpm --filter server build",
    "migrate": "pnpm --filter server migrate",
    "migrate:down": "pnpm --filter server migrate:down",
    "lint": "eslint \"packages/*/src/**/*.{ts,tsx}\"",
    "format": "prettier --write \"packages/*/src/**/*.{ts,tsx}\""
  },
  "pnpm": {
    "onlyBuiltDependencies": ["sharp", "esbuild"]
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "prettier": "^3.2.5",
    "typescript": "^5.4.0",
    "wait-on": "^9.0.5"
  }
}
