# ── Database ─────────────────────────────────────────────────────────────────
# Option A: individual variables (recommended for local dev)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=troupe
DB_USER=postgres
DB_PASSWORD=your-password

# Option B: connection string (takes precedence if set — useful for Railway, Heroku, etc.)
# DATABASE_URL=postgresql://user:password@localhost:5432/troupe

# ── Firebase Admin SDK ────────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"

# ── Cloudflare R2 ────────────────────────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=troupe-badges
R2_PUBLIC_URL=              # e.g. https://pub-xxx.r2.dev

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
